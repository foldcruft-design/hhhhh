# Telegram Bot Token (получить в @BotFather)
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# Google Gemini API Key (получить в Google AI Studio)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ID администраторов через запятую (узнать свой ID можно в @userinfobot)
ADMIN_IDS="123456789,987654321"

# Путь к базе данных SQLite
DATABASE_PATH="geoint_bot.db"

# Модель Gemini для визуального анализа GEOINT
GEMINI_MODEL="gemini-3.8-flash"

# Уровень логирования (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL="INFO"
